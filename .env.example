# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Public origin used in email auth links for Docker/VPS deployments
NEXT_PUBLIC_SITE_URL=https://feasibility-study.machinevision.global
# Optional: bucket name used by Admin image uploads (make sure the bucket exists in Supabase Storage)
NEXT_PUBLIC_CLIENT_ASSET_BUCKET=client-assets
# Optional: admin email used by password-only admin login flow
NEXT_PUBLIC_ADMIN_LOGIN_EMAIL=admin@machinevision.global

# n8n report chat webhook endpoints
# In development, the app prefers N8N_WEBHOOK_TEST_URL.
# In production, the app prefers N8N_WEBHOOK_URL.
N8N_WEBHOOK_URL= https://machinevisionind.app.n8n.cloud/webhook-test/f851af4d-6cd7-4577-bcd3-16884c938d1b/chat
N8N_WEBHOOK_TEST_URL=https://machinevisionind.app.n8n.cloud/webhook-test/f851af4d-6cd7-4577-bcd3-16884c938d1b/chat
# Optional bearer token if your n8n webhook is protected
N8N_WEBHOOK_TOKEN=

# Admin runner webhooks for markdown preview tools
N8N_REPORT_RUNNER_WEBHOOK_URL=https://machinevisionind.app.n8n.cloud/webhook-test/f851af4d-6cd7-4577-bcd3-16884c938d1b/report
N8N_PAGE_RUNNER_WEBHOOK_URL=https://machinevisionind.app.n8n.cloud/webhook-test/f851af4d-6cd7-4577-bcd3-16884c938d1b/page
N8N_REPORT_JSON_RUNNER_WEBHOOK_URL=
N8N_PAGE_JSON_RUNNER_WEBHOOK_URL=
