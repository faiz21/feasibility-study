            "title": "Plant Context and Maturity Snapshot",
            "body": {
              "blocks": [
                { "t": "p", "text": "The Green Plant has a mixed automation baseline: core assets are PLC-controlled but manual intervention, relay islands, and instrumentation reliability issues constrain operational stability and data trust." },
                { "t": "ul", "items": ["L1 is partially established", "L2 is fragmented", "L3 readiness remains limited without foundation upgrades"] }
              ]
            }
          },
          "meta": { "locale": "en", "tags": ["executive-summary", "narrative"], "createdAt": "2026-02-27T00:00:00Z" }
        },
