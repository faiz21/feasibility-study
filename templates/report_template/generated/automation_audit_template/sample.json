              "title": "Key Risk Themes",
              "body": {
                "blocks": [
                  { "t": "ul", "items": ["Bulk solids disruptions are not systematically instrumented", "Dust degrades sensor trust for stock visibility", "Alarm/event logging is inconsistent"] }
                ]
              }
            },
            "right": {
              "title": "Immediate Priorities (90-180 Days)",
              "body": {
                "blocks": [
                  { "t": "ul", "items": ["Complete L1 instrumentation and PLC integration survey", "Restore critical disabled sensors", "Implement baseline plant-wide alarm/event logging"] }
