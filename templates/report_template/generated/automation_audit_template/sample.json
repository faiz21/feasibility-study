          "meta": { "locale": "en", "tags": ["findings", "header"], "createdAt": "2026-02-27T00:00:00Z" }
        },
        {
          "type": "content.longFormOverview",
          "id": "fnd-lfo-003",
          "data": {
            "title": "Cross-Cutting Findings",
            "body": {
              "blocks": [
                { "t": "p", "text": "Control exists across the plant, but stability and data trust are constrained by manual interventions, harsh operating conditions, and weak event governance." },
                { "t": "ul", "items": ["Bulk solids handling is not yet closed-loop", "Sensor degradation in dusty environments reduces measurement trust", "Conveyor integrity monitoring is incomplete", "Alarm history and stop-cause coding are inconsistent"] }
              ]
            }
          },
          "meta": { "locale": "en", "tags": ["findings", "summary"], "createdAt": "2026-02-27T00:00:00Z" }
        },
        {
          "type": "content.twoColumnTextBlock",
          "id": "fnd-2ct-004",
          "data": {
            "left": {
              "title": "Operating Constraints",
              "body": {
                "blocks": [
                  { "t": "ul", "items": ["Manual dampers and RPM settings", "Choking/bridging are recurring but weakly instrumented", "Condition monitoring is not systematic for key rotating assets"] }
                ]
              }
            },
            "right": {
              "title": "Governance Constraints",
              "body": {
                "blocks": [
                  { "t": "ul", "items": ["Protective sensing has been disabled after false trips", "Alarm/event logs are not consistently retained", "Documentation and tag coverage gaps increase integration risk"] }
                ]
              }
            }
          },
          "meta": { "locale": "en", "tags": ["findings", "detail"], "createdAt": "2026-02-27T00:00:00Z" }
