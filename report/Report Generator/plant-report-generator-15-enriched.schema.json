{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mv-project.local/schemas/plant-report-generator/plant-report-generator-15-enriched.schema.json",
  "title": "Step 15 Enriched Report Data Schema",
  "description": "Enriched transformed schema for step 15: Appendix N \u2014 Vertical Integration: OT <-> IT Systems Evaluation",
  "allOf": [
    {
      "$ref": "./plant-report-generator-enriched-base.schema.json"
    },
    {
      "type": "object",
      "required": [
        "source_step",
        "report_profile",
        "step_payload",
        "quality_gate"
      ],
      "properties": {
        "source_step": {
          "type": "integer",
          "const": 15
        },
        "report_profile": {
          "type": "object",
          "required": [
            "appendix_code",
            "title"
          ],
          "properties": {
            "appendix_code": {
              "type": "string",
              "const": "N"
            },
            "title": {
              "type": "string",
              "const": "Appendix N \u2014 Vertical Integration: OT <-> IT Systems Evaluation"
            }
          },
          "additionalProperties": true
        },
        "step_payload": {
          "type": "object",
          "required": [
            "document_id_pattern",
            "prerequisite_steps",
            "consistency_checks_from",
            "sections",
            "outputs",
            "quality_gate"
          ],
          "properties": {
            "document_id_pattern": {
              "type": "string"
            },
            "prerequisite_steps": {
              "type": "array"
            },
            "consistency_checks_from": {
              "type": "array"
            },
            "sections": {
              "type": "object"
            },
            "outputs": {
              "type": "object"
            },
            "quality_gate": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "quality_gate": {
          "type": "object",
          "required": [
            "status",
            "checks"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pass",
                "warning",
                "fail"
              ]
            },
            "checks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "description",
                  "result"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "enum": [
                      "system-referenced-not-evidenced-in-authorized-sources",
                      "integration-point-uses-a-range-score",
                      "risk-level-contradicts-deterministic-mapping",
                      "arithmetic-average-incorrect",
                      "solution-code-not-in-solution-table"
                    ]
                  },
                  "description": {
                    "type": "string"
                  },
                  "result": {
                    "type": "string",
                    "enum": [
                      "pass",
                      "warning",
                      "fail"
                    ]
                  },
                  "details": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
