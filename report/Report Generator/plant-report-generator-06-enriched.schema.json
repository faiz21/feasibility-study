{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mv-project.local/schemas/plant-report-generator/plant-report-generator-06-enriched.schema.json",
  "title": "Step 06 Enriched Report Data Schema",
  "description": "Enriched transformed schema for step 6: Appendix E \u2014 Supervisory Control Scope: SCADA/DCS Inventory",
  "allOf": [
    {
      "$ref": "./plant-report-generator-enriched-base.schema.json"
    },
    {
      "type": "object",
      "required": [
        "source_step",
        "report_profile",
        "step_payload",
        "quality_gate"
      ],
      "properties": {
        "source_step": {
          "type": "integer",
          "const": 6
        },
        "report_profile": {
          "type": "object",
          "required": [
            "appendix_code",
            "title"
          ],
          "properties": {
            "appendix_code": {
              "type": "string",
              "const": "E"
            },
            "title": {
              "type": "string",
              "const": "Appendix E \u2014 Supervisory Control Scope: SCADA/DCS Inventory"
            }
          },
          "additionalProperties": true
        },
        "step_payload": {
          "type": "object",
          "required": [
            "document_id_pattern",
            "prerequisite_steps",
            "evidence_sources",
            "sections",
            "outputs",
            "quality_gate"
          ],
          "properties": {
            "document_id_pattern": {
              "type": "string"
            },
            "prerequisite_steps": {
              "type": "array"
            },
            "evidence_sources": {
              "type": "array"
            },
            "sections": {
              "type": "object"
            },
            "outputs": {
              "type": "object"
            },
            "quality_gate": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "quality_gate": {
          "type": "object",
          "required": [
            "status",
            "checks"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pass",
                "warning",
                "fail"
              ]
            },
            "checks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "description",
                  "result"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "enum": [
                      "scada-code-referenced-by-plc-not-found",
                      "year-built-non-numeric",
                      "coverage-contradicts-plc-linkage",
                      "historian-presence-asserted-without-keyword-evidence",
                      "narrative-introduces-systems-not-in-dataset"
                    ]
                  },
                  "description": {
                    "type": "string"
                  },
                  "result": {
                    "type": "string",
                    "enum": [
                      "pass",
                      "warning",
                      "fail"
                    ]
                  },
                  "details": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
