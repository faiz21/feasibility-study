{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mv-project.local/schemas/plant-report-generator/plant-report-generator-02-enriched.schema.json",
  "title": "Step 02 Enriched Report Data Schema",
  "description": "Enriched transformed schema for step 2: Appendix A \u2014 Material & Manufacturing Architecture",
  "allOf": [
    {
      "$ref": "./plant-report-generator-enriched-base.schema.json"
    },
    {
      "type": "object",
      "required": [
        "source_step",
        "report_profile",
        "step_payload",
        "quality_gate"
      ],
      "properties": {
        "source_step": {
          "type": "integer",
          "const": 2
        },
        "report_profile": {
          "type": "object",
          "required": [
            "appendix_code",
            "title"
          ],
          "properties": {
            "appendix_code": {
              "type": "string",
              "const": "A"
            },
            "title": {
              "type": "string",
              "const": "Appendix A \u2014 Material & Manufacturing Architecture"
            }
          },
          "additionalProperties": true
        },
        "step_payload": {
          "type": "object",
          "required": [
            "document_id_pattern",
            "prerequisite_steps",
            "output_format",
            "reference_schema",
            "evidence_sources",
            "output_schema",
            "quality_gate"
          ],
          "properties": {
            "document_id_pattern": {
              "type": "string"
            },
            "prerequisite_steps": {
              "type": "array"
            },
            "output_format": {
              "type": "string"
            },
            "reference_schema": {
              "type": "string"
            },
            "evidence_sources": {
              "type": "array"
            },
            "output_schema": {
              "type": "object"
            },
            "quality_gate": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "quality_gate": {
          "type": "object",
          "required": [
            "status",
            "checks"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pass",
                "warning",
                "fail"
              ]
            },
            "checks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "description",
                  "result"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "enum": [
                      "any-material-name-sensor-or-control-variable-introduced-without-",
                      "criticalcontrolpoints-ccps-controlvariable-is-invented-without-e",
                      "riskassessment-themes-analysis-riskifuncontrolled-introduces-eff",
                      "maturityanalysis-dimensions-linkedsolution-references-a-code-not",
                      "flowarchitecture-stages-processgroups-contains-a-code-not-in-pro",
                      "conclusion-prioritydirections-contains-solution-prescriptions-wi",
                      "any-chart-data-field-uses-invented-values-not-derivable-from-the",
                      "to-validate-field",
                      "all-chart-data-values-counts-scores-must-be-derived-from-the-dat"
                    ]
                  },
                  "description": {
                    "type": "string"
                  },
                  "result": {
                    "type": "string",
                    "enum": [
                      "pass",
                      "warning",
                      "fail"
                    ]
                  },
                  "details": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
