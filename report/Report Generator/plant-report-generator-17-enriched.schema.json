{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mv-project.local/schemas/plant-report-generator/plant-report-generator-17-enriched.schema.json",
  "title": "Step 17 Enriched Report Data Schema",
  "description": "Enriched transformed schema for step 17: Main Report Narrative \u2014 Management Overview Report",
  "allOf": [
    {
      "$ref": "./plant-report-generator-enriched-base.schema.json"
    },
    {
      "type": "object",
      "required": [
        "source_step",
        "report_profile",
        "step_payload",
        "quality_gate"
      ],
      "properties": {
        "source_step": {
          "type": "integer",
          "const": 17
        },
        "report_profile": {
          "type": "object",
          "required": [
            "appendix_code",
            "title"
          ],
          "properties": {
            "appendix_code": {
              "type": "string",
              "const": "MAIN"
            },
            "title": {
              "type": "string",
              "const": "Main Report Narrative \u2014 Management Overview Report"
            }
          },
          "additionalProperties": true
        },
        "step_payload": {
          "type": "object",
          "required": [
            "document_id_pattern",
            "report_header_fixed",
            "prerequisite_steps",
            "critical_rules",
            "sections",
            "maturity_table_dimensions",
            "outputs",
            "quality_gate"
          ],
          "properties": {
            "document_id_pattern": {
              "type": "string"
            },
            "report_header_fixed": {
              "type": "string"
            },
            "prerequisite_steps": {
              "type": "array"
            },
            "critical_rules": {
              "type": "object"
            },
            "sections": {
              "type": "array"
            },
            "maturity_table_dimensions": {
              "type": "array"
            },
            "outputs": {
              "type": "object"
            },
            "quality_gate": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "quality_gate": {
          "type": "object",
          "required": [
            "status",
            "checks"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pass",
                "warning",
                "fail"
              ]
            },
            "checks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "description",
                  "result"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "enum": [
                      "any-score-contradicts-appendix-m",
                      "solution-code-not-in-solution-list-referenced",
                      "issue-not-in-appendix-k-introduced",
                      "maturity-interpretation-contradicts-appendix-l-definitions"
                    ]
                  },
                  "description": {
                    "type": "string"
                  },
                  "result": {
                    "type": "string",
                    "enum": [
                      "pass",
                      "warning",
                      "fail"
                    ]
                  },
                  "details": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
