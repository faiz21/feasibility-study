{
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "docker:up": "bash -lc '(docker compose version >/dev/null 2>&1 && docker compose --env-file docker/.env.docker up -d --build) || docker-compose --env-file docker/.env.docker up -d --build'",
    "docker:down": "bash -lc '(docker compose version >/dev/null 2>&1 && docker compose --env-file docker/.env.docker down) || docker-compose --env-file docker/.env.docker down'",
    "docker:logs": "bash -lc '(docker compose version >/dev/null 2>&1 && docker compose --env-file docker/.env.docker logs -f --tail=200) || docker-compose --env-file docker/.env.docker logs -f --tail=200'",
    "docker:smoke": "bash scripts/smoke-docker-stack.sh",
    "render:md-grid": "node scripts/markdown-to-grid-html.mjs",
    "smoke:reports": "node scripts/smoke-reports-routes.mjs",
    "storybook": "NEXT_PRIVATE_LOCAL_WEBPACK=1 storybook dev -p 6006 --disable-telemetry",
    "build-storybook": "NEXT_PRIVATE_LOCAL_WEBPACK=1 storybook build --disable-telemetry"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
